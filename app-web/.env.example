# ---------------------------------------------------------------------------
# Configuracion multiempresa (multibase de datos SQL Server / Softland)
# ---------------------------------------------------------------------------
# Cada compania tiene su propia base de datos. Se define un JSON con la lista de
# companias disponibles (para el selector) y, por compania, la cadena de
# conexion y el esquema donde viven ARTICULO_PRECIO, la UDF y el SP.
#
# Copie este archivo a .env.local y complete los valores reales.
#
# Formato de COMPANIES_CONFIG (JSON en una sola linea).
# Cada compania define su CONEXION y, opcionalmente, un bloque "sql" para mapear
# los OBJETOS SQL (nombre del SP de margen, del SP de gestion de listas, de la
# UDF de factor de reduccion y los nombres de columnas/parametros). Lo que no se
# especifique en "sql" toma los valores por defecto (los de backend/sql):
#   spMargen               = SP_CALCULAR_MARGEN_MINIMO_ARTICULO
#   spGestionListas        = SP_GESTION_LISTAS_PRECIOS_CON_REDONDEO
#   udfFactorReduccion     = U_FACTOR_REDUCCION_MARGEN
#   tablaArticuloPrecio    = ARTICULO_PRECIO
#   tablaArticulo          = ARTICULO
#   colUdfCodigo           = U_CODIGO
#   colUdfDescripcion      = U_DESCRIP
#   colUdfFactor           = U_FACTOR_REDUCCION
#   colUdfActivo           = U_ACTIVO
#   paramNivelPrecio       = p_nivel_precio
#   paramVersion           = p_version
#   paramArticulo          = p_articulo
#   paramUsuario           = p_usuario_ult_modif
#
# Ejemplo con objetos SQL personalizados por compania:
# {
#   "COFER": { "label":"COFERSA","server":"10.0.0.10","database":"SOFTLAND_COFER","schema":"COFER","user":"app_user","password":"***" },
#   "FEBECA": { "label":"FEBECA","server":"10.0.0.11","database":"SOFTLAND_FEBECA","schema":"FEBECA","user":"app_user","password":"***",
#               "sql": { "spMargen":"SP_MARGEN_MIN","udfFactorReduccion":"UDT_FACTOR_MARGEN","colUdfFactor":"FACTOR","paramArticulo":"p_art" } }
# }
COMPANIES_CONFIG={"COFER":{"label":"COFERSA","server":"localhost","database":"SOFTLAND_COFER","schema":"COFER","user":"app_user","password":"CHANGE_ME"}}

# Puerto SQL Server (opcional, por defecto 1433)
SQL_PORT=1433

# Cifrado TLS de la conexion (true en Azure/entornos con certificado, false en dev local)
SQL_ENCRYPT=false

# Confiar en certificados de servidor autofirmados (solo dev/on-prem)
SQL_TRUST_SERVER_CERTIFICATE=true

# Modo demo: si es "true", la app NO conecta a SQL Server y usa un catalogo en
# memoria (util para ejecutar el portal sin base de datos disponible).
DEMO_MODE=true

# ---------------------------------------------------------------------------
# Esquema del PORTAL (estado de la app: usuarios, solicitudes, auditoria)
# ---------------------------------------------------------------------------
# El estado maker-checker se persiste SIEMPRE en el esquema del portal
# (default PORTAL_PRECIOS), independiente de la compania activa. La base del
# portal puede ser la misma que la operativa o una dedicada.
PORTAL_SCHEMA=PORTAL_PRECIOS
PORTAL_DB_SERVER=localhost
PORTAL_DB_NAME=SOFTLANDPRD
PORTAL_DB_USER=app_user
PORTAL_DB_PASSWORD=CHANGE_ME
