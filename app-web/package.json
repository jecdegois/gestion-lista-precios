{
  "name": "mv26020-gestion-masiva-precios",
  "version": "1.0.0",
  "private": true,
  "description": "Portal web full-stack (Next.js) para Gestion Masiva de Precios MV26020",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate --schema prisma-postgres && prisma generate --schema prisma-sqlserver",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate --schema prisma-postgres",
    "db:migrate": "prisma migrate dev --schema prisma-postgres",
    "db:deploy": "prisma migrate deploy --schema prisma-postgres",
    "db:studio": "prisma studio --schema prisma-postgres",
    "sqlserver:pull": "prisma db pull --schema prisma-sqlserver",
    "sqlserver:generate": "prisma generate --schema prisma-sqlserver",
    "sqlserver:studio": "prisma studio --schema prisma-sqlserver",
    "seed": "node --env-file=.env prisma-postgres/seed.cjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^6.19.3",
    "clsx": "^2.1.1",
    "env-var": "^7.5.0",
    "mssql": "10.0.2",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.88.0",
    "react-hot-toast": "^2.6.1",
    "xlsx": "0.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/mssql": "9.1.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "10.4.19",
    "postcss": "8.4.39",
    "prisma": "^6.19.3",
    "tailwindcss": "3.4.6",
    "typescript": "5.5.3"
  }
}
